# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=
# Speech-to-text model (hosted API) and the LLM used for speaker labels, rules and sentiment
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
# Set to 1 to run the whole app WITHOUT any API (uses the call scripts as a fake transcript
# and a keyword heuristic). For testing the UI only. Never use it for the reported accuracy.
MOCK_MODE=0
